# --- Langfuse (read automatically by the Langfuse SDK) ---
# Local self-hosted server (see README "Run Langfuse locally"), or https://cloud.langfuse.com
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-local
LANGFUSE_SECRET_KEY=sk-lf-local
# Tags every trace with an environment and a release, so you can filter by them in the UI.
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_RELEASE=v0.1.0

# --- The LLM (any OpenAI-compatible endpoint serving an open model) ---
# Groq (free tier): https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_your_key_here
LLM_MODEL=qwen/qwen3.8-27b

# OpenRouter free models work the same way (pick any model id ending in ":free"
# from https://openrouter.ai/models):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-your_key_here
# LLM_MODEL=<model-id>:free
